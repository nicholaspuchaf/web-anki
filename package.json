{
  "name": "iphone-study",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "flashcards:setup": "bun scripts/flashcard-search/cli.ts setup",
    "flashcards:index": "bun scripts/flashcard-search/cli.ts index",
    "flashcards:search": "bun scripts/flashcard-search/cli.ts search",
    "flashcards:compare": "bun scripts/flashcard-search/cli.ts compare",
    "flashcards:status": "bun scripts/flashcard-search/cli.ts status",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "bun test src",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:backend": "bun build backend/handler.ts --target=node --format=esm --minify --outfile=build/lambda/index.mjs",
    "test:backend": "bun test backend.test dynamo-store.test import-problem.test",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "hooks:install": "lefthook install",
    "security:setup": "bun scripts/install-trivy.ts",
    "security:trivy": ".tools/trivy-0.76.1/trivy fs --config trivy.yaml .",
    "security:malware": "bun scripts/scan-malware.ts",
    "security": "bun run security:malware && bun run security:trivy",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test && bun run build:backend && terraform -chdir=infra/terraform fmt -check -recursive && terraform -chdir=infra/terraform validate -no-color && bun run build",
    "check:all": "bun run check && bun run test:e2e:check",
    "prepush": "bunx --no-install lefthook run pre-push --force",
    "setup:checks": "bun run hooks:install && bun run security:setup && bunx playwright install chromium && terraform -chdir=infra/terraform init -backend=false",
    "test:e2e:check": "VITE_API_URL=https://folha-api.example PLAYWRIGHT_ISOLATED_BUILD=1 playwright test"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "idb": "^8.0.3"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1161.0",
    "@aws-sdk/lib-dynamodb": "^3.1161.0",
    "@eslint/js": "^10.0.1",
    "@huggingface/transformers": "4.3.2",
    "@playwright/test": "^1.64.1",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.4",
    "globals": "^17.13.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.2.0",
    "vite-plugin-pwa": "^1.1.0"
  },
  "trustedDependencies": [
    "lefthook"
  ]
}
