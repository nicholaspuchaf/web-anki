{
  "name": "iphone-study",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "bun test src",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:backend": "bun build backend/handler.ts --target=node --format=esm --minify --outfile=build/lambda/index.mjs",
    "test:backend": "bun test backend.test",
    "cloud:config": "bun scripts/write-cloud-config.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "hooks:install": "bun scripts/install-hooks.ts",
    "prepare": "bun run hooks:install",
    "security:setup": "bun scripts/install-trivy.ts",
    "security:trivy": "bun scripts/scan-trivy.ts",
    "security:malware": "bun scripts/scan-malware.ts",
    "security": "bun run security:malware && bun run security:trivy",
    "check": "bun scripts/check.ts",
    "check:all": "bun scripts/check.ts --e2e",
    "prepush": "bun run security && bun run check:all",
    "setup:checks": "bun run hooks:install && bun run security:setup && bunx playwright install chromium && terraform -chdir=infra/terraform init -backend=false"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "idb": "^8.0.3"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1161.0",
    "@aws-sdk/lib-dynamodb": "^3.1161.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.4",
    "globals": "^17.13.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.2.0",
    "vite-plugin-pwa": "^1.1.0"
  }
}
